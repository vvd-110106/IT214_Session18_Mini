{
  "info": {
    "_postman_id": "c1f7871b-2529-4501-8b2b-422201b17b20",
    "name": "RikkeiBank API - Microservices Collection",
    "description": "Postman Collection hoàn chỉnh cho dự án Ngân hàng số RikkeiBank API (Microservices Architecture). Bao gồm đầy đủ các kịch bản kiểm thử: Đăng ký/Đăng nhập, Quản lý danh mục, Truy vấn Cache-Aside Redis, Chuyển khoản phân tán Saga Happy Path, Kịch bản Rollback bù trừ, Bắn sự kiện Kafka Notification, Circuit Breaker và Ép buộc đăng xuất (Force Logout).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "teller_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer1_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer2_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & Security (Identity Service)",
      "item": [
        {
          "name": "1.1 Login as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('admin_token', jsonData.accessToken);",
                  "    console.log('Saved admin_token:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login as TELLER",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('teller_token', jsonData.accessToken);",
                  "    console.log('Saved teller_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"teller1\",\n  \"password\": \"teller123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login as CUSTOMER 1 (CIF001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('customer1_token', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    console.log('Saved customer1_token & refresh_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"cust123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Login as CUSTOMER 2 (CIF002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('customer2_token', jsonData.accessToken);",
                  "    console.log('Saved customer2_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer2\",\n  \"password\": \"cust123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.5 Refresh Token (Seamless Session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "1.6 Admin Force Logout User (Thu hồi quyền tức thì)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/customer2/force-logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "customer2", "force-logout"]
            }
          }
        },
        {
          "name": "1.7 Verify Force Logout (Customer 2 bị từ chối 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer2_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/1009876543",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "1009876543"]
            }
          }
        }
      ]
    },
